generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(cuid())
  email    String    @unique
  password String    // จะเก็บ bcrypt hash ไม่ใช่ plain text อีกต่อไป
  comments Comment[]
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  message   String
  tag       String?  // ← เพิ่มใหม่
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  postId    String                        // อ้างอิง post (เก็บเป็น string ตาม Week 8-9)
  text      String                        // เนื้อหาที่ผ่าน sanitizeHtml() แล้ว
  authorId  String                        // L4: เจ้าของ comment — ใช้ตรวจ Authorization
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}